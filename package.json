{
  "name": "@shieldfive/cli",
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source command-line client for ShieldFive: encrypts files on your machine before upload (contents: AES-256-GCM under an ML-KEM-1024 + X25519 hybrid key; names: AES-256-GCM under your vault key) and pushes or syncs them to your vault. Read the code.",
  "license": "Apache-2.0",
  "author": "Cho Garcia <security@shieldfive.com>",
  "homepage": "https://github.com/shieldfive/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shieldfive/cli.git"
  },
  "bugs": {
    "url": "https://github.com/shieldfive/cli/issues"
  },
  "keywords": [
    "shieldfive",
    "encryption",
    "post-quantum",
    "end-to-end-encryption",
    "client-side-encryption",
    "zero-knowledge",
    "backup",
    "sync",
    "cli"
  ],
  "bin": {
    "sf": "src/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@shieldfive/crypto": "~1.0.1",
    "@supabase/supabase-js": "^2",
    "libsodium-wrappers-sumo": "^0.8.2"
  },
  "optionalDependencies": {
    "argon2": "0.45.1"
  }
}
